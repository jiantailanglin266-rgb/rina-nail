# ==============================================================
# Rina nail — 環境変数サンプル
#
#   cp .env.example .env.local
#
# ここで設定した値は、本文・フッター・構造化データ（JSON-LD）・
# llms.txt にすべて自動で反映されます。
# 未設定の項目は {{PLACEHOLDER}} のまま出力されます。
# ==============================================================

# --- 必須 ---------------------------------------------------

# 本番の正規URL（末尾スラッシュなし）。canonical / hreflang / sitemap.xml の基準になります。
NEXT_PUBLIC_SITE_URL=https://rina-nail.example.com


# --- 公開前に差し替えが必要な項目 ------------------------------
# 未設定の場合、サイト上には {{BOOKING_URL}} のようなプレースホルダーが表示されます。

# 予約サイトのURL（すべての予約CTAのリンク先）
# NEXT_PUBLIC_BOOKING_URL=

# SNSのURL（ヘッダー・フッター・モバイルメニューのカラーアイコン、JSON-LD の sameAs）
# 設定したSNSだけがアイコンとして表示されます。未設定のSNSは表示されません。
# 例: NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/xxxxxxxx/
# NEXT_PUBLIC_INSTAGRAM_URL=
# NEXT_PUBLIC_LINE_URL=
# NEXT_PUBLIC_X_URL=
# NEXT_PUBLIC_TIKTOK_URL=
# NEXT_PUBLIC_YOUTUBE_URL=
# NEXT_PUBLIC_FACEBOOK_URL=

# 電話番号（未設定の場合、電話の導線は非表示になります）
# NEXT_PUBLIC_PHONE_NUMBER=

# 緯度・経度（JSON-LD の GeoCoordinates に使用）
# NEXT_PUBLIC_LATITUDE=
# NEXT_PUBLIC_LONGITUDE=

# 地図の埋め込みURL（Google マップの「地図を埋め込む」で取得した iframe の src）
# 未設定の場合、アクセスページの地図枠には案内文が表示されます。
# NEXT_PUBLIC_MAP_EMBED_URL=


# --- GitHub Pages でプレビュー公開する場合のみ -------------------
# 通常のデプロイ（Vercel など）では設定不要です。
# GITHUB_PAGES=true
# PAGES_BASE_PATH=/rina-nail

# --- ネット予約（Googleカレンダーの予約スケジュール） -------------
# Googleカレンダーで「予約スケジュール」を作成すると発行される予約ページURLです。
#
#   ※ Googleの通常のカレンダーURLではありません。
#     （calendar.google.com/calendar/u/0/r のようなURLは使えません）
#   ※ 予約スケジュールの設定画面から取得したURLを使ってください。
#   ※ URLの末尾に余計なパラメータを足さないでください。
#
# 受け付ける形式:
#   https://calendar.google.com/calendar/appointments/schedules/....
#   https://calendar.app.google/....
#
# 未設定でもサイトは正常に表示され、予約ページには準備中の案内が出ます。
# 取得手順は docs/GOOGLE-APPOINTMENT-SETUP.md を参照してください。
NEXT_PUBLIC_GOOGLE_BOOKING_URL=
