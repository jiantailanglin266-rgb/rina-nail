# ==============================================================
# Rina nail — 環境変数サンプル
#
#   cp .env.example .env.local
#
# ここで設定した値は、本文・フッター・構造化データ（JSON-LD）・
# llms.txt にすべて自動で反映されます。
# 未設定の項目は {{PLACEHOLDER}} のまま出力されます。
# ==============================================================

# --- 必須 ---------------------------------------------------

# 本番の正規URL（末尾スラッシュなし）。canonical / hreflang / sitemap.xml の基準になります。
NEXT_PUBLIC_SITE_URL=https://rina-nail.example.com


# --- 公開前に差し替えが必要な項目 ------------------------------
# 未設定の場合、サイト上には {{BOOKING_URL}} のようなプレースホルダーが表示されます。

# 予約サイトのURL（すべての予約CTAのリンク先）
# NEXT_PUBLIC_BOOKING_URL=

# InstagramのプロフィールURL（未設定の場合、Instagram導線は非表示になります）
# NEXT_PUBLIC_INSTAGRAM_URL=

# 電話番号（未設定の場合、電話の導線は非表示になります）
# NEXT_PUBLIC_PHONE_NUMBER=

# 緯度・経度（JSON-LD の GeoCoordinates に使用）
# NEXT_PUBLIC_LATITUDE=
# NEXT_PUBLIC_LONGITUDE=

# 地図の埋め込みURL（Google マップの「地図を埋め込む」で取得した iframe の src）
# 未設定の場合、アクセスページの地図枠には案内文が表示されます。
# NEXT_PUBLIC_MAP_EMBED_URL=


# --- GitHub Pages でプレビュー公開する場合のみ -------------------
# 通常のデプロイ（Vercel など）では設定不要です。
# GITHUB_PAGES=true
# PAGES_BASE_PATH=/rina-nail
